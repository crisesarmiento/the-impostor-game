#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/Users/cristiansarmiento/Projects/GitProjects/the-impostor-game/node_modules/.pnpm/partykit@0.0.94/node_modules/partykit/dist/node_modules:/Users/cristiansarmiento/Projects/GitProjects/the-impostor-game/node_modules/.pnpm/partykit@0.0.94/node_modules/partykit/node_modules:/Users/cristiansarmiento/Projects/GitProjects/the-impostor-game/node_modules/.pnpm/partykit@0.0.94/node_modules:/Users/cristiansarmiento/Projects/GitProjects/the-impostor-game/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/Users/cristiansarmiento/Projects/GitProjects/the-impostor-game/node_modules/.pnpm/partykit@0.0.94/node_modules/partykit/dist/node_modules:/Users/cristiansarmiento/Projects/GitProjects/the-impostor-game/node_modules/.pnpm/partykit@0.0.94/node_modules/partykit/node_modules:/Users/cristiansarmiento/Projects/GitProjects/the-impostor-game/node_modules/.pnpm/partykit@0.0.94/node_modules:/Users/cristiansarmiento/Projects/GitProjects/the-impostor-game/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../partykit/dist/bin.mjs" "$@"
else
  exec node  "$basedir/../partykit/dist/bin.mjs" "$@"
fi
